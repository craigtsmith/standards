{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./fallow/preset.jsonc"],
  "ignorePatterns": ["dist/**"],
  "ignoreDependencies": [
    "eslint-plugin-jsdoc",
    "eslint-plugin-perfectionist",
    "eslint-plugin-sonarjs"
  ],
  "audit": { "healthBaseline": "fallow-health-baseline.json" },
  "entry": [
    "oxfmt.config.ts",
    "oxfmt/index.ts",
    "oxlint.config.ts",
    "oxlint/config/index.ts",
    "oxlint/config/rules/perfectionist/*.probe.ts",
    "oxlint/plugin/index.ts"
  ],
  "boundaries": {
    "coverage": { "allowUnmatched": ["*.config.ts"] },
    "zones": [
      { "name": "plugin/ast", "patterns": ["oxlint/plugin/rules/lib/ast/**"] },
      { "name": "plugin/types", "patterns": ["oxlint/plugin/rules/lib/types/**"] },
      { "name": "plugin/widening", "patterns": ["oxlint/plugin/rules/lib/widening/**"] },
      { "name": "plugin/rules", "patterns": ["oxlint/plugin/**"] },
      { "name": "config", "patterns": ["oxlint/config/**"] },
      { "name": "oxfmt", "patterns": ["oxfmt/**"] }
    ],
    "rules": [
      { "from": "plugin/ast", "allow": [] },
      { "from": "plugin/types", "allow": ["plugin/ast"] },
      { "from": "plugin/widening", "allow": ["plugin/ast", "plugin/types"] },
      { "from": "plugin/rules", "allow": ["plugin/ast", "plugin/types", "plugin/widening"] },
      { "from": "config", "allow": [] },
      { "from": "oxfmt", "allow": [] }
    ]
  }
}
