{
  "$schema": "../../node_modules/fallow/schema.json",
  "extends": ["../../fallowrc.jsonc"],
  // Oxlint JS plugins. packages/standards/oxlint/config/index.ts loads them by
  // name through import.meta.resolve, which fallow cannot trace as an import.
  "ignoreDependencies": ["eslint-plugin-perfectionist", "eslint-plugin-sonarjs"]
}
