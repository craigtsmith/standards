{
  "name": "@craigts.dev/standards",
  "version": "0.0.1",
  "private": true,
  "description": "oxlint, oxfmt, fallow and tsconfig presets for craigts.dev projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craigtsmith/standards.git"
  },
  "files": [
    "oxlint",
    "oxfmt",
    "fallow.jsonc",
    "tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint/config/index.ts",
    "./oxlint/plugin": "./oxlint/plugin/index.ts",
    "./oxfmt": "./oxfmt/index.ts",
    "./fallow.jsonc": "./fallow.jsonc",
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "scripts": {
    "fallow:audit": "fallow audit --base HEAD",
    "fallow:baseline": "fallow health --save-baseline fallow-health-baseline.json --baseline-mode identity; oxfmt fallow-health-baseline.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-sonarjs": "^4.2.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^26.2.0",
    "fallow": "^3.18.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@oxlint/plugins": "1.81.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0"
  },
  "packageManager": "pnpm@10.34.5"
}
